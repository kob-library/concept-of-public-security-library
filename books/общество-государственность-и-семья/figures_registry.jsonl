{"figure_id": "общество-государственность-и-семья--image1", "work_id": "общество-государственность-и-семья", "work_dir": "общество-государственность-и-семья", "section_id": "общество-государственность-и-семья/s12", "source_kind": "docx_embedded", "containing_source": "Общество — государственность и семья.doc", "source_page": null, "original_filename": "image1.jpeg", "media_file": "image1.jpeg", "caption": "Имение сохранялось за Гончаровыми только благодаря тому, что Екатерина II возвела его в ранг майората, и по действовавшим законам империи майорат было невозможно ни заложить, ни продать, ни проиграть в карты, ни разделить на доли, а можно было только передать как единое целое по наследству старшему в роду; в случае же отсутствия наследников — майорат отходил в казну.", "figure_label": null, "media_type": "map", "rights_status": "rights_review_required", "criticality": "useful", "provenance_class": "third_party_reproduction", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "361c5dc22479dd86d44bd48148ec35d1041980f6fce771b2f2863f86cb669626", "public_asset_sha256": null}
{"figure_id": "общество-государственность-и-семья--image2", "work_id": "общество-государственность-и-семья", "work_dir": "общество-государственность-и-семья", "section_id": "общество-государственность-и-семья/s12", "source_kind": "docx_embedded", "containing_source": "Общество — государственность и семья.doc", "source_page": null, "original_filename": "image2.jpeg", "media_file": "image2.jpeg", "caption": "Первые две фотографии представляют в двух ракурсах крестьянскую избу, стоящую на острове Кижи (Северо-запад России, республика Карелия) в одноимённом архитектурно-этно­гра­фическом музее-заповед­нике[^139]. Это дом Сергеевой из деревни Липовицы, датируемый концом XIX — началом ХХ века.", "figure_label": null, "media_type": "photo", "rights_status": "rights_review_required", "criticality": "useful", "provenance_class": "third_party_photo", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "050026083bb58f24555908065eb7d5a5c9a0c43fb7eefa2c3f98dce62633d1ef", "public_asset_sha256": null}

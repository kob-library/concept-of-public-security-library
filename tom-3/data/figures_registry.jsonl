{"figure_id": "osnovy-sociologii-tom-3--image4", "work_id": "osnovy-sociologii-tom-3", "work_dir": "tom-3", "section_id": "subsections/ch-10-s10-02-01.md", "source_kind": "docx_embedded_preview", "containing_source": "osnovy-sociologii-tom-3.doc", "source_page": 228, "original_filename": "image4.jpeg", "media_file": "image4.jpeg", "caption": "Как один из участков Змиевых валов выглядит в наши дни, даёт представление фото слева (снимок сделан с гребня вала). Наши предки, создав Змиевы валы, внесли свой вклад и в нашу победу в Великой Отечественной войне, поскольку в 1941 г. танки вермахта в ряде случаев не могли переползти через их гребни и вынуждены были обходить валы стороной или искать в них разрывы и проходы.", "figure_label": null, "media_type": "photo", "rights_status": "rights_review_required", "criticality": "useful", "provenance_class": "third_party_photo", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "5e627a1c9d7062b39189dfeec987e9cceff5d13bdb6b26b08db6931cf104d641", "public_asset_sha256": null}

{"figure_id": "osnovy-sociologii-tom-2--image14", "work_id": "osnovy-sociologii-tom-2", "work_dir": "tom-2", "section_id": "sections/ch-08-s08-02.md", "source_kind": "docx_embedded_preview", "containing_source": "osnovy-sociologii-tom-2.doc", "source_page": null, "original_filename": "image14.wmf", "media_file": "image14.png", "caption": "А на фото внизу — фотография местности в окрестностях горы Арарат на территории современной Турции[^55]. В нижней части кадра правее от центра запечатлён объект, который интерпретируется как занесённые геологическими отложени­ями последующих времён окаменевшие остатки Ноева ковчега, на том основании, что в ходе  ар­хе­ологических раскопок в его районе были обнаружены древние каменные якоря соответ…", "figure_label": null, "media_type": "photo", "rights_status": "rights_review_required", "criticality": "critical_for_understanding", "provenance_class": "third_party_photo", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "c9be29b58f5738d5c7b024bd86cad05d1e3beca4fe760cf4f6ca2444b9f6f03c", "public_asset_sha256": null}

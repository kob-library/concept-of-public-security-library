{"figure_id": "osnovy-sociologii-tom-4--image8", "work_id": "osnovy-sociologii-tom-4", "work_dir": "tom-4", "section_id": "subsections/ch-12-s12-02-06.md", "source_kind": "docx_embedded_preview", "containing_source": "osnovy-sociologii-tom-4.doc", "source_page": null, "original_filename": "image8.wmf", "media_file": "image8.png", "caption": "К сожалению, в 1941 году СССР был способен только к последнему и, хвала Богу, что победил в Великой Отечественной войне. И один из символов воплощения безжалостности Любви известен всему миру[^136]: фото выше. А те, кто в последующие годы сдал и сдаёт без сопротивления достигнутое народами в Советско-Ста­лин­ский период истории России-СССР поработителям, те — греховодники, и С.А. Тороп и ему подоб…", "figure_label": null, "media_type": "photo", "rights_status": "rights_review_required", "criticality": "critical_for_understanding", "provenance_class": "third_party_photo", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "ad178a7c693d50e049805e164706959babc367564b9db6ee0d114b8f6fcba9db", "public_asset_sha256": null}

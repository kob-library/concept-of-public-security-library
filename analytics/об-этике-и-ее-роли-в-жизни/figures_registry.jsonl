{"figure_id": "об-этике-и-ее-роли-в-жизни--image7", "work_id": "об-этике-и-ее-роли-в-жизни", "work_dir": "об-этике-и-ее-роли-в-жизни", "section_id": "об-этике-и-ее-роли-в-жизни/s05", "source_kind": "docx_embedded", "containing_source": "dotu.ru:e1f20689b3a30bfa.doc", "source_page": null, "original_filename": "image7.jpeg", "media_file": "image7.jpeg", "caption": "«В городе Куйбышеве Новосибирской области фермер привез на тракторе кучу навоза и вывалил её перед офисом Сбербанка. Удобрения сибиряк дополнил плакатами: «Банкиры — враги народа» и «Долой кредитное рабство». Навозом Александр Бакшаев пытался погасить остаток долга перед банком. «Я же должник и отвечаю перед кредитором своим имуществом. У меня как раз в банке около 50 тысяч долгу. Тогда возьмите е…", "figure_label": null, "media_type": "other", "rights_status": "rights_review_required", "criticality": "unclear", "provenance_class": "third_party_photo", "referenced_in_text": true, "ref_count": 1, "anchor_confidence": null, "publication_status": "metadata_only_rights", "public_path": null, "source_sha256": "2ec64634973b391cbbc1957638210f521dd1747744d9b52613b069a8f821ba2a", "public_asset_sha256": null}
